@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.User

@{
    ViewData["Title"] = "Xóa người dùng";
}

<section class="admin-card admin-form">
    <div class="admin-card-header">
        <div>
            <h2 class="admin-card-title">Xóa người dùng</h2>
            <p class="admin-card-subtitle">Tài khoản bị xóa sẽ không thể đăng nhập.</p>
        </div>
    </div>
    <div class="admin-card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="alert alert-danger">
            Bạn có chắc muốn xóa người dùng <strong>@Model.Username</strong>?
        </div>

        <dl class="row admin-detail-list">
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Họ tên</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Vai trò</dt>
            <dd class="col-sm-8">@Model.Role</dd>
        </dl>

        <form asp-action="Delete" class="d-flex gap-2">
            <input type="hidden" asp-for="UserId" />
            <button type="submit" class="btn btn-danger">Xóa người dùng</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </form>
    </div>
</section>
