@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.User

@{
    ViewData["Title"] = "Xoa nguoi dung";
}

<h2>Xoa nguoi dung</h2>
<hr />

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="alert alert-warning">
    Ban co chac muon xoa user <strong>@Model.Username</strong>?
</div>

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Ho ten</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Vai tro</dt>
    <dd class="col-sm-9">@Model.Role</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="UserId" />
    <button type="submit" class="btn btn-danger">Xoa</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lai</a>
</form>
