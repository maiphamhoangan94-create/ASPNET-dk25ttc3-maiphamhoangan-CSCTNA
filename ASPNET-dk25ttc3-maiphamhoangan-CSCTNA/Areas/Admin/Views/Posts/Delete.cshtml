@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.Post

@{
    ViewData["Title"] = "Xóa bài viết";
    var trangThai = Model.Status == 1 ? "Đã duyệt" : Model.Status == 2 ? "Từ chối" : "Chờ duyệt";
}

<section class="admin-card admin-form">
    <div class="admin-card-header">
        <div>
            <h2 class="admin-card-title">Xóa bài viết</h2>
            <p class="admin-card-subtitle">Bài viết bị xóa sẽ không còn hiển thị trong hệ thống.</p>
        </div>
    </div>
    <div class="admin-card-body">
        <div class="alert alert-danger">
            Bạn có chắc muốn xóa bài viết <strong>@Model.Title</strong>?
        </div>

        <dl class="row admin-detail-list">
            <dt class="col-sm-4">Tiêu đề</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">@trangThai</dd>

            <dt class="col-sm-4">Mã danh mục</dt>
            <dd class="col-sm-8">@Model.CategoryId</dd>

            <dt class="col-sm-4">Mã tác giả</dt>
            <dd class="col-sm-8">@Model.UserId</dd>
        </dl>

        <form asp-action="Delete" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Xóa bài viết</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </form>
    </div>
</section>
