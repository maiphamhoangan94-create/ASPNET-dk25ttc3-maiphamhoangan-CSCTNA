@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.Category

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<section class="admin-card admin-form">
    <div class="admin-card-header">
        <div>
            <h2 class="admin-card-title">Chi tiết danh mục</h2>
            <p class="admin-card-subtitle">Thông tin đang lưu cho danh mục này.</p>
        </div>
    </div>
    <div class="admin-card-body">
        <dl class="row admin-detail-list">
            <dt class="col-sm-4">Tên danh mục</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Đường dẫn</dt>
            <dd class="col-sm-8">@Model.Slug</dd>

            <dt class="col-sm-4">Ảnh danh mục</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded object-fit-cover me-2" style="width: 88px; height: 64px;" />
                    <span class="text-muted">@Model.ImageUrl</span>
                }
                else
                {
                    <span class="text-muted">Chưa có ảnh</span>
                }
            </dd>
        </dl>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Sửa</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </div>
</section>
