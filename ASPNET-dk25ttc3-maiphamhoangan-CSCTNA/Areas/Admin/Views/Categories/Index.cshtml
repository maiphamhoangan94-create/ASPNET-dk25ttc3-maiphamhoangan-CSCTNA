@model IEnumerable<ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.Category>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(danhMuc => danhMuc.Name)
            </th>
            <th>
                @Html.DisplayNameFor(danhMuc => danhMuc.Slug)
            </th>
            <th>
                @Html.DisplayNameFor(danhMuc => danhMuc.Posts)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var danhMuc in Model) {
        <tr>
            <td>
                @Html.DisplayFor(giaTri => danhMuc.Name)
            </td>
            <td>
                @Html.DisplayFor(giaTri => danhMuc.Slug)
            </td>
            <td>
                @Html.DisplayFor(giaTri => danhMuc.Posts)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@danhMuc.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@danhMuc.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@danhMuc.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
