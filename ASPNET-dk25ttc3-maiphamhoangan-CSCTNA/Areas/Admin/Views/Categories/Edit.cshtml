@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.Category

@{
    ViewData["Title"] = "Sửa danh mục";
}

<section class="admin-card admin-form">
    <div class="admin-card-header">
        <div>
            <h2 class="admin-card-title">Sửa danh mục</h2>
            <p class="admin-card-subtitle">Cập nhật thông tin danh mục.</p>
        </div>
    </div>
    <div class="admin-card-body">
        <form enctype="multipart/form-data" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Tên danh mục</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label">Đường dẫn</label>
                <input asp-for="Slug" class="form-control" />
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="imageFile" class="form-label">Ảnh danh mục</label>
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="Ảnh hiện tại" class="img-thumbnail d-block mb-2" style="max-height: 160px;" />
                }
                <div class="form-text mb-2">Để trống để giữ ảnh hiện tại.</div>
                <input type="file" id="imageFile" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
                <div class="form-text">Chọn ảnh JPG, PNG, WEBP hoặc GIF, tối đa 5 MB.</div>
                @Html.ValidationMessage("imageFile", null, new { @class = "text-danger" })
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
