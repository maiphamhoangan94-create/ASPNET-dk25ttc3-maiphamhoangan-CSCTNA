@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<section class="admin-card admin-form">
    <div class="admin-card-header">
        <div>
            <h2 class="admin-card-title">Xóa danh mục</h2>
            <p class="admin-card-subtitle">Vui lòng kiểm tra trước khi xóa.</p>
        </div>
    </div>
    <div class="admin-card-body">
        <div class="alert alert-danger">
            Bạn có chắc muốn xóa danh mục <strong>@Model.Name</strong>?
        </div>

        <dl class="row admin-detail-list">
            <dt class="col-sm-4">Tên danh mục</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Đường dẫn</dt>
            <dd class="col-sm-8">@Model.Slug</dd>
        </dl>

        <form asp-action="Delete" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Xóa danh mục</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </form>
    </div>
</section>
