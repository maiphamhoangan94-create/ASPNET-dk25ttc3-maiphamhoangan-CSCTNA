<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị Bếp Nhà</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Afacad:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                <span class="admin-brand-mark">BN</span>
                <span>
                    <strong>Bếp Nhà</strong>
                    <small>Quản trị</small>
                </span>
            </a>

            <nav class="admin-nav">
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <span>Danh mục</span>
                </a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Posts" asp-action="Index">
                    <span>Bài viết</span>
                </a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <span>Người dùng</span>
                </a>
            </nav>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div>
                    <p class="admin-eyebrow">Khu vực quản trị</p>
                    <h1>@(ViewData["Title"] ?? "Tổng quan")</h1>
                </div>
                <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-controller="Home" asp-action="Index">Xem website</a>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
