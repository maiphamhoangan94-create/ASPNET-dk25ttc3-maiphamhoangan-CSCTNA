@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<section class="auth-section bg-warm py-5">
    <div class="container py-4">
        <div class="row justify-content-center align-items-stretch g-4">
            <div class="col-lg-5 col-md-8">
                <div class="auth-card bg-white rounded-5 shadow-sm p-4 p-md-5 h-100">
                    <div class="mb-4">
                        <span class="text-uppercase tracking-wider text-muted small fw-semibold">GIA NHẬP CỘNG ĐỒNG</span>
                        <h1 class="font-serif fw-bold text-dark mt-2 mb-2">Tạo tài khoản Bếp Nhà</h1>
                        <p class="text-secondary small mb-0">Lưu món yêu thích, gửi công thức của riêng bạn và cùng mọi người lan tỏa vị ngon cơm nhà.</p>
                    </div>

                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
                }

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                        <input asp-for="Username" class="form-control auth-input" placeholder="Chọn tên đăng nhập" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control auth-input" placeholder="Nhập email của bạn" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="FullName" class="form-label">Họ và tên</label>
                        <input asp-for="FullName" class="form-control auth-input" placeholder="Tên hiển thị trong cộng đồng" />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu</label>
                        <input asp-for="Password" class="form-control auth-input" type="password" placeholder="Tạo mật khẩu" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                        <input asp-for="ConfirmPassword" class="form-control auth-input" type="password" placeholder="Nhập lại mật khẩu" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-terracotta rounded-pill py-2 fw-semibold w-100">Đăng ký</button>
                </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <small class="text-muted">Đã có tài khoản? <a asp-action="Login" class="text-terracotta fw-semibold text-decoration-none">Đăng nhập</a></small>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="auth-visual h-100 rounded-5 overflow-hidden shadow">
                    <img src="https://images.unsplash.com/photo-1495521821757-a1efb6729352?q=80&w=900" class="h-100 w-100 object-fit-cover" alt="Chuẩn bị nguyên liệu nấu ăn">
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
