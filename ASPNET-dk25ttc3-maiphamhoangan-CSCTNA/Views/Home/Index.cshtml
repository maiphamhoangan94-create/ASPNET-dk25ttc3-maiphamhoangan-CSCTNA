@model IEnumerable<ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.Post>

@{
    ViewData["Title"] = "Trang chủ";
}

<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-uppercase tracking-wider text-muted small fw-semibold">TIN & CÔNG THỨC MỚI</span>
                <h2 class="fw-bold text-dark mt-1 mb-0">Công thức đã được duyệt từ cộng đồng</h2>
            </div>
            <a asp-controller="Recipes" asp-action="Create" class="btn btn-terracotta rounded-pill px-4 d-none d-md-inline">Đăng công thức</a>
        </div>

        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var post in Model)
                {
                    var content = post.Content ?? "";
                    var excerpt = content.Length > 95 ? content.Substring(0, 95) + "..." : content;
                    var provinces = post.PostProvinces
                        .Select(postProvince => postProvince.Province?.Name)
                        .Where(provinceName => !string.IsNullOrWhiteSpace(provinceName))
                        .ToList();
                    var provinceDisplay = provinces.Count >= 3
                        ? string.Join(", ", provinces.Take(2)) + ", ..."
                        : string.Join(", ", provinces);

                    <div class="col-md-6 col-lg-3">
                        <article class="card card-recipe h-100 border-0 rounded-4 shadow-sm overflow-hidden">
                            <img src="@(string.IsNullOrWhiteSpace(post.ImageUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500" : post.ImageUrl)" class="card-img-top recipe-img" alt="@post.Title">
                            <div class="card-body p-3">
                                <span class="badge bg-light text-terracotta border mb-2 d-inline-flex align-items-center gap-1">
                                    @if (!string.IsNullOrWhiteSpace(post.Category?.ImageUrl))
                                    {
                                        <img src="@post.Category.ImageUrl" alt="@post.Category.Name" class="rounded-circle object-fit-cover" style="width: 18px; height: 18px;" />
                                    }
                                    @(post.Category?.Name ?? "Công thức")
                                </span>
                                <h3 class="h6 card-title fw-bold text-dark mb-2">@post.Title</h3>
                                @if (provinces.Any())
                                {
                                    <div class="text-muted extra-small mb-2" title="@string.Join(", ", provinces)">
                                        <i class="fa-solid fa-location-dot me-1"></i>@provinceDisplay
                                    </div>
                                }
                                <p class="text-muted small mb-3">@excerpt</p>
                                <div class="d-flex justify-content-between text-muted extra-small">
                                    <span><i class="fa-regular fa-user me-1"></i>@(post.User?.FullName ?? post.User?.Username ?? "Thành viên")</span>
                                    <span>@post.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-warm rounded-4 p-4 p-md-5 text-center">
                <h3 class="h5 fw-bold text-dark">Chưa có công thức nào được duyệt</h3>
                <p class="text-secondary mb-3">Khách vẫn có thể xem trang chủ. Thành viên đăng nhập có thể gửi công thức để quản trị viên duyệt.</p>
                <a asp-controller="Recipes" asp-action="Create" class="btn btn-terracotta rounded-pill px-4">Gửi công thức đầu tiên</a>
            </div>
        }
    </div>
</section>
