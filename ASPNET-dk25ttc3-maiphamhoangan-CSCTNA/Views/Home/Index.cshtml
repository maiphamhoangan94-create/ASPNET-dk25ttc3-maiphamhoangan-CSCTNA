@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Trang chủ";

    var tasteCategories = Model.TasteCategories;
    var suggestedPosts = Model.SuggestedPosts;
    var featuredKitchen = Model.FeaturedKitchenCorner;
    var featuredRecipe = Model.FeaturedRecipe;
    const string categoryFallbackImage = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400";
}

<section class="bg-warm py-5">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="text-uppercase tracking-wider text-muted small fw-semibold">CÔNG THỨC & CẢM HỨNG</span>
                <h1 class="font-serif display-4 fw-bold text-dark mt-2 mb-4">
                    Nơi khởi nguồn cảm hứng và sẻ chia vị ngon cơm nhà.
                </h1>
                <p class="text-secondary lead fs-6 mb-4">
                    Mỗi món ăn là một câu chuyện, mỗi hương vị là một kỷ niệm. Cùng Bếp Nhà lưu giữ và lan tỏa những bữa ăn ấm áp gia đình Việt.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Recipes" asp-action="Index" class="btn btn-terracotta rounded-pill px-4 py-2">Khám phá công thức</a>
                    <a asp-controller="Recipes" asp-action="Inspiration" class="btn btn-outline-dark rounded-pill px-4 py-2">Tìm kiếm theo nguyên liệu</a>
                </div>
                <div class="d-flex gap-4 text-muted small pt-2">
                    <span><i class="fa-solid fa-check text-terracotta me-1"></i> Không cần đăng ký</span>
                    <span><i class="fa-solid fa-check text-terracotta me-1"></i> Miễn phí 100%</span>
                    <span><i class="fa-solid fa-check text-terracotta me-1"></i> Chuẩn vị ba miền</span>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="rounded-5 overflow-hidden shadow-lg">
                    <img src="https://cdn2.tuoitre.vn/tcdulichtphcm/media/upload/1-2025/images/2025-03-25/1742898108-481231772_122140861622606002_6478007692031959728_n.jpg" class="img-fluid w-100 object-fit-cover" style="max-height: 480px;" alt="Bữa cơm nhà">
                </div>
            </div>
        </div>

        <div class="row text-center g-4 mt-5 pt-4 border-top">
            <div class="col-6 col-md-3">
                <h2 class="font-serif fw-bold text-terracotta display-6">15,000+</h2>
                <p class="text-muted small mb-0">Công thức cơm nhà</p>
            </div>
            <div class="col-6 col-md-3">
                <h2 class="font-serif fw-bold text-terracotta display-6">250K+</h2>
                <p class="text-muted small mb-0">Thành viên cộng đồng</p>
            </div>
            <div class="col-6 col-md-3">
                <h2 class="font-serif fw-bold text-terracotta display-6">64/64</h2>
                <p class="text-muted small mb-0">Tỉnh thành bao phủ</p>
            </div>
            <div class="col-6 col-md-3">
                <h2 class="font-serif fw-bold text-terracotta display-6">4.9★</h2>
                <p class="text-muted small mb-0">Đánh giá hài lòng</p>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-uppercase tracking-wider text-muted small fw-semibold">KHÁM PHÁ THEO KHẨU VỊ</span>
                <h2 class="font-serif fw-bold text-dark mt-1">Định nghĩa mâm cơm nhà bằng hương vị bạn yêu thích nhất</h2>
            </div>
            <a href="#taste-categories" class="text-terracotta text-decoration-none fw-semibold small d-none d-md-inline">Xem tất cả hương vị →</a>
        </div>

        <div class="row g-3" id="taste-categories">
            @if (tasteCategories.Any())
            {
                foreach (var category in tasteCategories)
                {
                    var categoryImage = string.IsNullOrWhiteSpace(category.ImageUrl) ? categoryFallbackImage : category.ImageUrl;

                    <div class="col-6 col-md-4 col-lg-2-4">
                        <a asp-controller="Recipes" asp-action="Index" asp-route-categoryId="@category.Id" class="card card-taste border-0 rounded-4 overflow-hidden text-white shadow-sm h-100 text-decoration-none">
                            <img src="@categoryImage" class="card-img h-100 object-fit-cover" alt="@category.Name">
                            <div class="card-img-overlay d-flex align-items-end p-3 bg-dark-gradient">
                                <h6 class="card-title fw-bold mb-0">@category.Name</h6>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-muted mb-0">Chưa có danh mục món ăn để hiển thị.</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5 bg-warm">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-uppercase tracking-wider text-muted small fw-semibold">GỢI Ý HÔM NAY CHO BẠN</span>
                <h2 class="font-serif fw-bold text-dark mt-1">Hôm nay Bếp Nhà thèm món gì? Thử ngay công thức được khuyên nấu!</h2>
            </div>
            <a asp-controller="Recipes" asp-action="Index" class="btn btn-terracotta rounded-pill px-4 d-none d-md-inline">Khám phá tất cả công thức</a>
        </div>

        @if (suggestedPosts.Any())
        {
            <div class="row g-4">
                @foreach (var post in suggestedPosts)
                {
                    var provinces = post.PostProvinces
                        .Select(postProvince => postProvince.Province?.Name)
                        .Where(provinceName => !string.IsNullOrWhiteSpace(provinceName))
                        .ToList();
                    var provinceDisplay = provinces.Count >= 3
                        ? string.Join(", ", provinces.Take(2)) + ", ..."
                        : string.Join(", ", provinces);

                    <div class="col-md-6 col-lg-3">
                        <article class="card card-recipe h-100 border-0 rounded-4 shadow-sm overflow-hidden">
                            <a asp-controller="Recipes" asp-action="Details" asp-route-id="@post.Id" class="text-decoration-none d-flex flex-column h-100">
                                <img src="@(string.IsNullOrWhiteSpace(post.ImageUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500" : post.ImageUrl)" class="card-img-top recipe-img" alt="@post.Title">
                                <div class="card-body p-3">
                                    <span class="badge bg-light text-terracotta border mb-2 d-inline-flex align-items-center gap-1">
                                        @if (!string.IsNullOrWhiteSpace(post.Category?.ImageUrl))
                                        {
                                            <img src="@post.Category.ImageUrl" alt="@post.Category.Name" class="rounded-circle object-fit-cover" style="width: 18px; height: 18px;" />
                                        }
                                        @(post.Category?.Name ?? "Công thức")
                                    </span>
                                    <h3 class="h6 card-title fw-bold text-dark mb-2">@post.Title</h3>
                                    @if (provinces.Any())
                                    {
                                        <div class="text-muted extra-small mb-2" title="@string.Join(", ", provinces)">
                                            <i class="fa-solid fa-location-dot me-1"></i>@provinceDisplay
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between text-muted extra-small">
                                        <span><i class="fa-regular fa-user me-1"></i>@(post.User?.FullName ?? post.User?.Username ?? "Thành viên")</span>
                                        <span>@post.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </a>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-4 p-4 p-md-5 text-center">
                <h3 class="h5 fw-bold text-dark">Chưa có công thức nào được duyệt</h3>
                <p class="text-secondary mb-3">Thành viên đăng nhập có thể gửi công thức để quản trị viên duyệt.</p>
                <a asp-controller="Recipes" asp-action="Create" class="btn btn-terracotta rounded-pill px-4">Gửi công thức đầu tiên</a>
            </div>
        }
    </div>
</section>

<section class="py-5 bg-white text-center">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <i class="fa-solid fa-quote-left text-terracotta opacity-25 fs-1 mb-3"></i>
                <blockquote class="font-serif fs-4 fw-normal text-dark fst-italic lh-base mb-3">
                    "Hương vị của quê hương không nằm ở những gia vị xa xỉ, mà nằm ở ngọn lửa ấm áp trong căn bếp nhỏ của mẹ, và những tiếng cười giòn tan đón chờ bữa cơm chiều sau ngày dài bận rộn."
                </blockquote>
                <p class="text-terracotta font-serif fw-bold">— Bếp Trưởng Bếp Nhà —</p>
            </div>
        </div>
    </div>
</section>

@if (featuredKitchen != null)
{
    var kitchenAuthorName = featuredKitchen.User?.FullName ?? featuredKitchen.User?.Username ?? "Thành viên Bếp Nhà";
    var kitchenImage = featuredKitchen.GalleryImages.FirstOrDefault()
        ?? featuredKitchen.ImageUrl
        ?? "https://images.unsplash.com/photo-1556911220-bff31c812dba?w=900";
    var kitchenDescription = string.IsNullOrWhiteSpace(featuredKitchen.Content)
        ? $"Gian bếp của {kitchenAuthorName} đang được cộng đồng yêu thích nhờ điểm sao cao và các món ăn được đánh giá nổi bật."
        : featuredKitchen.Content;

    <section class="py-5 bg-warm">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-5">
                    <div class="rounded-5 overflow-hidden shadow">
                        <img src="@kitchenImage" class="img-fluid w-100 object-fit-cover" style="max-height: 520px;" alt="@featuredKitchen.Title">
                    </div>
                </div>
                <div class="col-lg-7">
                    <span class="text-uppercase tracking-wider text-muted small fw-semibold">GÓC BẾP ƯU TÚ THÁNG NÀY</span>
                    <h2 class="font-serif display-6 fw-bold text-dark mt-1 mb-3">@featuredKitchen.Title</h2>
                    <div class="d-flex flex-wrap gap-3 text-muted small mb-3">
                        <span><i class="fa-solid fa-star text-terracotta me-1"></i>@Model.FeaturedKitchenAverageRating.ToString("0.0") sao góc bếp</span>
                        <span><i class="fa-solid fa-utensils text-terracotta me-1"></i>@Model.FeaturedAuthorRecipeAverageRating.ToString("0.0") sao trung bình món ăn</span>
                    </div>
                    <p class="text-secondary mb-4">@kitchenDescription</p>
                    @if (featuredRecipe != null)
                    {
                        <div class="card border-0 rounded-4 p-3 mb-4 bg-white shadow-sm">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrWhiteSpace(featuredRecipe.ImageUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100" : featuredRecipe.ImageUrl)" class="rounded-3 object-fit-cover" width="60" height="60" alt="@featuredRecipe.Title">
                                <div>
                                    <span class="badge bg-terracotta-light text-terracotta mb-1">Món Nổi Bật Của Gian Bếp · @Model.FeaturedRecipeAverageRating.ToString("0.0") sao</span>
                                    <h6 class="fw-bold text-dark mb-0">@featuredRecipe.Title</h6>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="d-flex gap-3">
                        <a asp-controller="KitchenCorners" asp-action="Details" asp-route-id="@featuredKitchen.Id" class="btn btn-terracotta rounded-pill px-4">Ghé thăm gian bếp này</a>
                        <a asp-controller="KitchenCorners" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Khám phá góc bếp khác</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="text-uppercase tracking-wider text-muted small fw-semibold">CẢM NHẬN TỪ CỘNG ĐỒNG</span>
            <h2 class="font-serif fw-bold text-dark mt-1">Hạnh phúc lấp đầy gian bếp của gia đình Việt khắp thế giới</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 rounded-4 p-4 bg-warm h-100">
                    <p class="card-text text-secondary small mb-4">
                        "Từ ngày biết Bếp Nhà, mình không còn phải đau đầu nghĩ xem 'Hôm nay ăn gì' nữa. Các công thức chuẩn vị và rất dễ làm theo!"
                    </p>
                    <div class="d-flex align-items-center gap-3 mt-auto">
                        <span class="rounded-circle bg-secondary-subtle d-inline-block flex-shrink-0" style="width: 40px; height: 40px;" aria-hidden="true"></span>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark small">Thảo My</h6>
                            <small class="text-muted extra-small">Hà Nội, Việt Nam</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 rounded-4 p-4 bg-warm h-100">
                    <p class="card-text text-secondary small mb-4">
                        "Xa quê hương bao nhiêu năm, nhờ Bếp Nhà mà mình tìm lại được chính xác hương vị canh chua cá lóc ngày xưa mẹ nấu."
                    </p>
                    <div class="d-flex align-items-center gap-3 mt-auto">
                        <span class="rounded-circle bg-secondary-subtle d-inline-block flex-shrink-0" style="width: 40px; height: 40px;" aria-hidden="true"></span>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark small">Minh Cường</h6>
                            <small class="text-muted extra-small">Tokyo, Nhật Bản</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 rounded-4 p-4 bg-warm h-100">
                    <p class="card-text text-secondary small mb-4">
                        "Giao diện đẹp, dễ tìm kiếm và hình ảnh món ăn rất truyền cảm hứng. Một trang web không thể thiếu cho hội yêu bếp!"
                    </p>
                    <div class="d-flex align-items-center gap-3 mt-auto">
                        <span class="rounded-circle bg-secondary-subtle d-inline-block flex-shrink-0" style="width: 40px; height: 40px;" aria-hidden="true"></span>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark small">Lê Ngọc Anh</h6>
                            <small class="text-muted extra-small">Đà Nẵng, Việt Nam</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-warm">
    <div class="container">
        <div class="bg-terracotta text-white rounded-5 p-4 p-md-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <span class="text-uppercase tracking-wider small opacity-75">BẢN TIN BẾP NHÀ MỖI TUẦN</span>
                    <h3 class="font-serif fw-bold mt-1 mb-2">Nhen nhóm lửa hồng cho căn bếp nhà bạn cùng chúng tôi</h3>
                    <p class="mb-0 opacity-90 small">Nhận ngay 5 công thức món ăn ngon chuẩn vị mỗi tuần gửi trực tiếp vào hòm thư của bạn.</p>
                </div>
                <div class="col-lg-5">
                    <form class="d-flex flex-column gap-2" data-newsletter-form>
                        <input type="email" class="form-control rounded-pill px-4 border-0 py-2" placeholder="Nhập địa chỉ email của bạn...">
                        <button type="button" class="btn btn-dark rounded-pill px-4 py-2 fw-semibold">Đăng ký nhận bản tin ngay</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
