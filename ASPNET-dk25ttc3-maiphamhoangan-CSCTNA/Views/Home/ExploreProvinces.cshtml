@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.ProvinceExploreViewModel

@{
    ViewData["Title"] = "Khám phá Tỉnh thành";

    var provinces = ViewBag.Provinces as IEnumerable<Province> ?? Enumerable.Empty<Province>();
    const string fallbackImage = "https://images.unsplash.com/photo-1504674900247-0877df9cc836?q=80&w=700";
}

<section class="bg-warm province-hero py-5">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="text-uppercase tracking-wider text-muted small fw-semibold">BẢN ĐỒ VỊ NGON VIỆT NAM</span>
                <h1 class="font-serif display-5 fw-bold text-dark mt-2 mb-3">
                    Khám phá món ăn theo từng tỉnh thành
                </h1>
                <p class="text-secondary fs-5 mb-4">
                    Mỗi vùng đất có một hương vị riêng. Chọn tỉnh thành để xem các công thức đã được gắn địa phương và tìm cảm hứng cho bữa cơm hôm nay.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <span class="province-stat"><strong>@Model.TotalProvinceCount</strong> tỉnh thành</span>
                    <span class="province-stat"><strong>@Model.TotalRecipeCount</strong> món đã map địa phương</span>
                </div>
            </div>
            <div class="col-lg-5">
                <form asp-controller="Home" asp-action="ExploreProvinces" method="get" class="province-filter bg-white shadow-sm">
                    <label for="provinceId" class="form-label fw-bold text-dark mb-2">Chọn tỉnh thành</label>
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <select id="provinceId" name="provinceId" class="form-select rounded-pill">
                            <option value="">Tất cả tỉnh thành</option>
                            @foreach (var province in provinces)
                            {
                                <option value="@province.Id" selected="@(Model.SelectedProvinceId == province.Id)">
                                    @province.Name
                                </option>
                            }
                        </select>
                        <button type="submit" class="btn btn-terracotta rounded-pill px-4 flex-shrink-0">
                            Khám phá
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap mb-4">
            <div>
                <span class="text-uppercase tracking-wider text-muted small fw-semibold">MÓN NGON ĐỊA PHƯƠNG</span>
                <h2 class="font-serif fw-bold text-dark mt-1 mb-0">
                    @(Model.SelectedProvinceId.HasValue ? $"Hương vị {Model.SelectedProvinceName}" : "Bộ sưu tập món ăn các tỉnh thành")
                </h2>
            </div>
            @if (Model.SelectedProvinceId.HasValue)
            {
                <a asp-controller="Home" asp-action="ExploreProvinces" class="btn btn-outline-secondary rounded-pill px-4">Xem tất cả</a>
            }
        </div>

        @if (Model.ProvinceGroups.Any())
        {
            <div class="province-group-list">
                @foreach (var group in Model.ProvinceGroups)
                {
                    <section class="province-group">
                        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                            <div>
                                <h3 class="h4 fw-bold text-dark mb-1">
                                    <i class="fa-solid fa-location-dot text-terracotta me-2"></i>@group.Province.Name
                                </h3>
                                <p class="text-muted mb-0 small">@group.Posts.Count món ăn đang được giới thiệu</p>
                            </div>
                            <a asp-controller="Home" asp-action="ExploreProvinces" asp-route-provinceId="@group.Province.Id" class="text-terracotta text-decoration-none fw-semibold small">Lọc tỉnh này</a>
                        </div>

                        @if (group.Posts.Any())
                        {
                            <div class="row g-4">
                                @foreach (var post in group.Posts)
                                {
                                    <div class="col-md-6 col-lg-4">
                                        <article class="card card-recipe h-100 border-0 rounded-4 shadow-sm overflow-hidden">
                                            <a asp-controller="Recipes" asp-action="Details" asp-route-id="@post.Id" class="text-decoration-none d-flex flex-column h-100">
                                                <img src="@(string.IsNullOrWhiteSpace(post.ImageUrl) ? fallbackImage : post.ImageUrl)" class="card-img-top province-recipe-img" alt="@post.Title">
                                                <div class="card-body p-4">
                                                    <span class="badge bg-terracotta-light text-terracotta mb-2">@(post.Category?.Name ?? "Công thức")</span>
                                                    <h4 class="h5 fw-bold text-dark mb-2">@post.Title</h4>
                                                    <p class="text-secondary small province-card-content mb-3">
                                                        @(string.IsNullOrWhiteSpace(post.Content) ? "Cùng khám phá câu chuyện và cách nấu món ăn này." : post.Content)
                                                    </p>
                                                    <div class="d-flex justify-content-between align-items-center text-muted extra-small mt-auto">
                                                        <span><i class="fa-regular fa-user me-1"></i>@(post.User?.FullName ?? post.User?.Username ?? "Thành viên")</span>
                                                        <span>@post.CreatedAt.ToString("dd/MM/yyyy")</span>
                                                    </div>
                                                </div>
                                            </a>
                                        </article>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="province-empty rounded-4 p-4">
                                <h4 class="h6 fw-bold text-dark mb-1">Chưa có món ăn được map với @group.Province.Name</h4>
                                <p class="text-secondary small mb-3">Bạn có thể đăng công thức mới và chọn tỉnh thành này để làm phong phú bản đồ ẩm thực.</p>
                                <a asp-controller="Recipes" asp-action="Create" class="btn btn-terracotta rounded-pill px-4">Tạo công thức</a>
                            </div>
                        }
                    </section>
                }
            </div>
        }
        else
        {
            <div class="province-empty rounded-4 p-5 text-center">
                <h3 class="h5 fw-bold text-dark">Chưa có dữ liệu tỉnh thành để hiển thị</h3>
                <p class="text-secondary mb-0">Hãy kiểm tra dữ liệu tỉnh thành trong hệ thống.</p>
            </div>
        }
    </div>
</section>
