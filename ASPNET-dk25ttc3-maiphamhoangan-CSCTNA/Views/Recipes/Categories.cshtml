@model List<ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.Category>

@{
    ViewData["Title"] = "Tất cả hương vị";
    const string fallbackImage = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400";
}

<section class="py-5 bg-white">
    <div class="container py-4">
        <nav aria-label="Điều hướng" class="mb-4">
            <a asp-controller="Home" asp-action="Index" class="text-terracotta text-decoration-none">← Trang chủ</a>
        </nav>
        <div class="mb-4">
            <span class="text-uppercase tracking-wider text-muted small fw-semibold">KHÁM PHÁ THEO KHẨU VỊ</span>
            <h1 class="font-serif fw-bold text-dark mt-1">Tất cả hương vị</h1>
            <p class="text-secondary mb-0">Chọn danh mục yêu thích để khám phá các công thức món ăn.</p>
        </div>

        @if (Model.Any())
        {
            <div class="row g-3">
                @foreach (var category in Model)
                {
                    var categoryImage = string.IsNullOrWhiteSpace(category.ImageUrl) ? fallbackImage : category.ImageUrl;
                    <div class="col-6 col-md-4 col-lg-2-4">
                        <a asp-controller="Recipes" asp-action="Index" asp-route-categoryId="@category.Id" class="card card-taste border-0 rounded-4 overflow-hidden text-white shadow-sm text-decoration-none">
                            <img src="@categoryImage" class="card-img h-100 object-fit-cover" alt="@category.Name" loading="lazy">
                            <div class="card-img-overlay d-flex align-items-end p-3 bg-dark-gradient">
                                <h2 class="h6 card-title fw-bold mb-0">@category.Name</h2>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted mb-0">Chưa có danh mục món ăn để hiển thị.</p>
        }
    </div>
</section>
