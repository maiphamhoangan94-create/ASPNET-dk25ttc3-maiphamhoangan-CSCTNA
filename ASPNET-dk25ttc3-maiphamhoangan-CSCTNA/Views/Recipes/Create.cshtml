@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.Post

@{
    ViewData["Title"] = "Đăng công thức";
}

<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">
                <div class="mb-4">
                    <span class="text-uppercase tracking-wider text-muted small fw-semibold">GÓP BẾP CÙNG CỘNG ĐỒNG</span>
                    <h1 class="h2 fw-bold text-dark mt-2 mb-2">Đăng công thức nấu ăn của bạn</h1>
                    <p class="text-secondary mb-0">Chia sẻ món ngon gia đình. Công thức sau khi gửi sẽ ở trạng thái chờ duyệt trước khi hiển thị công khai.</p>
                </div>

                @if (TempData["RecipeCreatedMessage"] != null)
                {
                    <div class="alert alert-success rounded-3" role="alert">
                        @TempData["RecipeCreatedMessage"]
                    </div>
                }

                <form enctype="multipart/form-data" asp-action="Create" method="post" class="recipe-submit-form bg-warm rounded-4 p-4 p-md-5">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Tên công thức</label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Ví dụ: Cá kho tộ tiêu xanh" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục món ăn</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select form-select-lg">
                            <option value="">Chọn danh mục</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label for="imageFile" class="form-label fw-semibold">Ảnh món ăn</label>
                        <input type="file" id="imageFile" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
                <div class="form-text">Chọn ảnh JPG, PNG, WEBP hoặc GIF, tối đa 5 MB.</div>
                        @Html.ValidationMessage("imageFile", null, new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label asp-for="SelectedProvinceIds" class="form-label fw-semibold">Tỉnh thành áp dụng</label>
                        <select asp-for="SelectedProvinceIds" asp-items="ViewBag.Provinces" class="form-select" multiple size="8"></select>
                        <span asp-validation-for="SelectedProvinceIds" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Ingredients" class="form-label fw-semibold">Nguyên liệu</label>
                        <input type="hidden" asp-for="Ingredients" id="Ingredients" />
                        <div class="ingredient-entry rounded-4 p-3">
                            <div id="ingredientRows" class="vstack gap-2">
                                <div class="ingredient-row">
                                    <div class="position-relative">
                        <input type="text" class="form-control ingredient-name" placeholder="Tên nguyên liệu" aria-label="Tên nguyên liệu" autocomplete="off" aria-expanded="false" />
                        <div class="ingredient-options position-absolute bg-white border rounded shadow-sm w-100" style="z-index: 10; max-height: 240px; overflow-y: auto" hidden></div>
                    </div>
                                    <input type="text" class="form-control ingredient-amount" placeholder="Lượng" aria-label="Lượng nguyên liệu" />
                                    <input type="text" class="form-control ingredient-note" placeholder="Ghi chú" aria-label="Ghi chú nguyên liệu" />
                                    <button type="button" class="btn btn-outline-secondary ingredient-remove" aria-label="Xóa nguyên liệu">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mt-3">
                                <button type="button" class="btn btn-outline-terracotta rounded-pill px-3" id="addIngredientRow">
                                    <i class="fa-solid fa-plus me-1"></i>Thêm nguyên liệu
                                </button>
                                <span class="text-muted small">Nhập tên để chọn nguyên liệu đã có hoặc thêm nguyên liệu mới.</span>
                            </div>
                        </div>
                        <span asp-validation-for="Ingredients" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold">Cách làm và ghi chú</label>
                        <textarea asp-for="Content" class="form-control" rows="9" placeholder="Ví dụ: Sơ chế cá, ướp 20 phút, kho lửa nhỏ..."></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="submit" class="btn btn-terracotta rounded-pill px-4 py-2">Gửi công thức</button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">Về trang chủ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const rowsContainer = document.getElementById('ingredientRows');
            const addButton = document.getElementById('addIngredientRow');
            const hiddenInput = document.getElementById('Ingredients');

            if (!rowsContainer || !addButton || !hiddenInput) {
                return;
            }

            const ingredientSuggestions = @Json.Serialize(ViewBag.IngredientSuggestions);
            const normalizeName = value => value.toLowerCase().normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/\s+/g, ' ').trim();
            const hideOptions = () => {
                rowsContainer.querySelectorAll('.ingredient-options').forEach(panel => panel.hidden = true);
                rowsContainer.querySelectorAll('.ingredient-name').forEach(input => input.setAttribute('aria-expanded', 'false'));
            };
            const showOptions = input => {
                hideOptions();
                const panel = input.parentElement.querySelector('.ingredient-options');
                const query = normalizeName(input.value);
                const matches = ingredientSuggestions.filter(item => normalizeName(item.name).includes(query)).slice(0, 8);
                panel.replaceChildren();
                matches.forEach(item => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'btn btn-light text-start w-100 rounded-0';
                    button.textContent = item.name;
                    button.addEventListener('click', () => {
                        input.value = item.name;
                        syncIngredients();
                        input.focus();
                        hideOptions();
                    });
                    panel.appendChild(button);
                });
                panel.hidden = matches.length === 0;
                input.setAttribute('aria-expanded', String(matches.length > 0));
            };
            rowsContainer.addEventListener('focusin', event => {
                if (event.target.matches('.ingredient-name')) showOptions(event.target);
            });
            rowsContainer.addEventListener('input', event => {
                if (event.target.matches('.ingredient-name')) showOptions(event.target);
            });
            rowsContainer.addEventListener('keydown', event => {
                if (event.key === 'Escape') hideOptions();
                if (event.key === 'ArrowDown' && event.target.matches('.ingredient-name')) {
                    const first = event.target.parentElement.querySelector('.ingredient-options:not([hidden]) button');
                    if (first) { event.preventDefault(); first.focus(); }
                }
            });
            document.addEventListener('click', event => {
                if (!event.target.closest('.ingredient-name, .ingredient-options')) hideOptions();
            });
            rowsContainer.addEventListener('focusout', () => {
                setTimeout(() => {
                    if (!document.activeElement?.closest('.ingredient-name, .ingredient-options')) hideOptions();
                }, 0);
            });

            const createRow = () => {
                const row = document.createElement('div');
                row.className = 'ingredient-row';
                row.innerHTML = `
                    <div class="position-relative">
                        <input type="text" class="form-control ingredient-name" placeholder="Tên nguyên liệu" aria-label="Tên nguyên liệu" autocomplete="off" aria-expanded="false" />
                        <div class="ingredient-options position-absolute bg-white border rounded shadow-sm w-100" style="z-index: 10; max-height: 240px; overflow-y: auto" hidden></div>
                    </div>
                    <input type="text" class="form-control ingredient-amount" placeholder="Lượng" aria-label="Lượng nguyên liệu" />
                    <input type="text" class="form-control ingredient-note" placeholder="Ghi chú" aria-label="Ghi chú nguyên liệu" />
                    <button type="button" class="btn btn-outline-secondary ingredient-remove" aria-label="Xóa nguyên liệu">
                        <i class="fa-solid fa-xmark"></i>
                    </button>`;
                return row;
            };

            const syncIngredients = () => {
                const lines = Array.from(rowsContainer.querySelectorAll('.ingredient-row'))
                    .map(row => {
                        const name = row.querySelector('.ingredient-name')?.value.trim() ?? '';
                        const amount = row.querySelector('.ingredient-amount')?.value.trim() ?? '';
                        const note = row.querySelector('.ingredient-note')?.value.trim() ?? '';

                        if (!name && !amount && !note) {
                            return '';
                        }

                        const main = [name, amount].filter(Boolean).join(' - ');
                        return note && main ? `${main} (${note})` : (main || note);
                    })
                    .filter(Boolean);

                hiddenInput.value = lines.join('\n');
            };

            addButton.addEventListener('click', () => {
                const row = createRow();
                rowsContainer.appendChild(row);
                row.querySelector('.ingredient-name')?.focus();
            });

            rowsContainer.addEventListener('input', syncIngredients);
            rowsContainer.addEventListener('click', event => {
                const removeButton = event.target.closest('.ingredient-remove');
                if (!removeButton) {
                    return;
                }

                const rows = rowsContainer.querySelectorAll('.ingredient-row');
                if (rows.length === 1) {
                    rows[0].querySelectorAll('input').forEach(input => input.value = '');
                } else {
                    removeButton.closest('.ingredient-row')?.remove();
                }

                syncIngredients();
            });

            const existingLines = hiddenInput.value.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
            if (existingLines.length > 0) {
                rowsContainer.innerHTML = '';
                existingLines.forEach(line => {
                    const row = createRow();
                    row.querySelector('.ingredient-name').value = line;
                    rowsContainer.appendChild(row);
                });
            }

            document.querySelector('.recipe-submit-form')?.addEventListener('submit', syncIngredients);
        })();
    </script>
}
