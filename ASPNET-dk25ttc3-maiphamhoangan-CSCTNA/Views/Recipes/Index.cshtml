@model ASPNET_dk25ttc3_maiphamhoangan_CSCTNA.Models.RecipeListViewModel

@{
    ViewData["Title"] = "Khám phá công thức";
    const string fallbackImage = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600";
}

<section class="recipe-list-hero bg-warm py-5">
    <div class="container py-4">
        <div class="row align-items-end g-4">
            <div class="col-lg-8">
                <span class="text-uppercase tracking-wider text-muted small fw-semibold">THƯ VIỆN CÔNG THỨC</span>
                <h1 class="font-serif display-5 fw-bold text-dark mt-2 mb-3">Khám phá tất cả công thức cơm nhà</h1>
                <p class="text-secondary mb-0">
                    Tìm cảm hứng cho bữa ăn hôm nay từ những công thức đã được Bếp Nhà duyệt và chia sẻ bởi cộng đồng.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container py-4">
        <form method="get" asp-controller="Recipes" asp-action="Index" class="recipe-category-filter mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-6 col-lg-4">
                    <label for="categoryId" class="form-label fw-semibold text-dark">Lọc theo danh mục</label>
                    <select id="categoryId" name="categoryId" class="form-select" onchange="this.form.submit()">
                        <option value="">Tất cả danh mục</option>
                        @foreach (var category in Model.Categories)
                        {
                            if (Model.SelectedCategoryId == category.Id)
                            {
                                <option value="@category.Id" selected>@category.Name</option>
                            }
                            else
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-terracotta rounded-pill px-4">
                        <i class="fa-solid fa-filter me-2"></i>Lọc
                    </button>
                    @if (Model.SelectedCategoryId.HasValue)
                    {
                        <a asp-controller="Recipes" asp-action="Index" class="btn btn-outline-terracotta rounded-pill px-4">Xóa lọc</a>
                    }
                </div>
            </div>
        </form>

        @if (Model.Recipes.Any())
        {
            <div class="d-flex justify-content-between align-items-center mb-4">
                <p class="text-muted mb-0">
                    Trang @Model.CurrentPage / @Model.TotalPages · @Model.TotalRecipes công thức
                </p>
                <a asp-controller="Recipes" asp-action="Create" class="btn btn-terracotta rounded-pill px-4">
                    Tạo công thức
                </a>
            </div>

            <div class="row g-4">
                @foreach (var post in Model.Recipes)
                {
                    var provinces = post.PostProvinces
                        .Select(postProvince => postProvince.Province?.Name)
                        .Where(provinceName => !string.IsNullOrWhiteSpace(provinceName))
                        .ToList();
                    var provinceDisplay = provinces.Count >= 3
                        ? string.Join(", ", provinces.Take(2)) + ", ..."
                        : string.Join(", ", provinces);

                    <div class="col-md-6 col-lg-3">
                        <article class="card card-recipe h-100 border-0 rounded-4 shadow-sm overflow-hidden">
                            <div class="d-flex flex-column h-100">
                                <a asp-controller="Recipes" asp-action="Details" asp-route-id="@post.Id" class="text-decoration-none">
                                <img src="@(string.IsNullOrWhiteSpace(post.ImageUrl) ? fallbackImage : post.ImageUrl)" class="card-img-top recipe-img" alt="@post.Title">
                                </a>
                                <div class="card-body p-3 d-flex flex-column">
                                    <span class="badge bg-light text-terracotta border mb-2 d-inline-flex align-items-center gap-1 align-self-start">
                                        @if (!string.IsNullOrWhiteSpace(post.Category?.ImageUrl))
                                        {
                                            <img src="@post.Category.ImageUrl" alt="@post.Category.Name" class="rounded-circle object-fit-cover" style="width: 18px; height: 18px;" />
                                        }
                                        @(post.Category?.Name ?? "Công thức")
                                    </span>
                                    <h2 class="h6 card-title fw-bold mb-2">
                                        <a asp-controller="Recipes" asp-action="Details" asp-route-id="@post.Id" class="text-dark text-decoration-none">@post.Title</a>
                                    </h2>
                                    @if (provinces.Any())
                                    {
                                        <div class="text-muted extra-small mb-2" title="@string.Join(", ", provinces)">
                                            <i class="fa-solid fa-location-dot me-1"></i>@provinceDisplay
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between text-muted extra-small mt-auto">
                                        <span>
                                            <i class="fa-regular fa-user me-1"></i>
                                            <a asp-controller="Account" asp-action="Profile" asp-route-id="@post.UserId" class="text-muted text-decoration-none">@(post.User?.FullName ?? post.User?.Username ?? "Thành viên")</a>
                                        </span>
                                        <span>@post.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-5" aria-label="Phân trang công thức">
                    <ul class="pagination recipe-pagination justify-content-center mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? string.Empty : "disabled")">
                            <a class="page-link" asp-controller="Recipes" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-page="@(Model.CurrentPage - 1)" aria-label="Trang trước">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>
                        </li>

                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : string.Empty)">
                                <a class="page-link" asp-controller="Recipes" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-page="@pageNumber">@pageNumber</a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? string.Empty : "disabled")">
                            <a class="page-link" asp-controller="Recipes" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-page="@(Model.CurrentPage + 1)" aria-label="Trang sau">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="recipe-empty rounded-4 p-4 p-md-5 text-center">
                <h2 class="h4 fw-bold text-dark">Chưa có công thức phù hợp</h2>
                <p class="text-secondary mb-3">Thử chọn danh mục khác hoặc gửi thêm công thức để làm phong phú căn bếp cộng đồng.</p>
                <a asp-controller="Recipes" asp-action="Create" class="btn btn-terracotta rounded-pill px-4">Gửi công thức đầu tiên</a>
            </div>
        }
    </div>
</section>
