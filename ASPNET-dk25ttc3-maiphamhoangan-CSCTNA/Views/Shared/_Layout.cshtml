@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHomeActive = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isInspirationActive = string.Equals(currentController, "Recipes", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Inspiration", StringComparison.OrdinalIgnoreCase);
    var isProvinceActive = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "ExploreProvinces", StringComparison.OrdinalIgnoreCase);
    var isKitchenActive = string.Equals(currentController, "KitchenCorners", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Bếp Nhà") - Bếp Nhà</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Afacad:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-warm sticky-top py-3">
        <div class="container">
            <a class="navbar-brand font-serif fw-bold text-terracotta fs-3" asp-controller="Home" asp-action="Index">Bếp Nhà</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link px-3 @(isHomeActive ? "active" : string.Empty)" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link px-3 @(isInspirationActive ? "active" : string.Empty)" asp-controller="Recipes" asp-action="Inspiration">Cảm hứng</a></li>
                    <li class="nav-item"><a class="nav-link px-3 @(isProvinceActive ? "active" : string.Empty)" asp-controller="Home" asp-action="ExploreProvinces">Khám phá Tỉnh thành</a></li>
                    <li class="nav-item"><a class="nav-link px-3 @(isKitchenActive ? "active" : string.Empty)" asp-controller="KitchenCorners" asp-action="Index">Góc Bếp Ưu Tú</a></li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <a asp-controller="Account" asp-action="Profile" class="text-muted text-decoration-none small">Xin chào, @Context.Session.GetString("Username")</a>
                        <a asp-controller="Account" asp-action="Logout" class="text-dark text-decoration-none small">Đăng xuất</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="text-dark text-decoration-none small">Đăng nhập</a>
                    }
                    <a asp-controller="Recipes" asp-action="Create" class="btn btn-terracotta rounded-pill px-4">Tạo công thức</a>
                </div>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="bg-dark-footer text-light py-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4">
                    <h4 class="font-serif fw-bold text-white mb-3">Bếp Nhà</h4>
                    <p class="footer-text small">Nơi khởi nguồn cảm hứng và sẻ chia vị ngon cơm nhà. Nối liền tình thân qua từng bữa ăn ấm áp.</p>
                    <div class="d-flex gap-3 social-icons">
                        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#"><i class="fa-brands fa-youtube"></i></a>
                        <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold text-white mb-3">Về Bếp Nhà</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="footer-link">Giới thiệu</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Sứ mệnh</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Tuyển dụng</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold text-white mb-3">Khám Phá</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="footer-link">Công thức mới</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Món ăn 3 miền</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Góc Bếp Ưu Tú</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold text-white mb-3">Hỗ Trợ</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#" class="footer-link">Hướng dẫn đăng bài</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Quy định cộng đồng</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Liên hệ</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-top border-secondary pt-4 text-center footer-text small">
                © 2026 Bếp Nhà. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
